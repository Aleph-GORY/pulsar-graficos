##
# 
# Pulsar gráficos site configuration 
# 
##

server {
	listen 80 ;
	listen [::]:80 ;
    server_name pulsargraficos.com;
    return 301 https://$host$request_uri;
}
server {
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    server_name pulsargraficos.com; # managed by Certbot

    ssl_certificate /etc/letsencrypt/live/pulsargraficos.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pulsargraficos.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    
    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # proxy_set_header X-Forwarded-Proto $scheme;
    
	location / {
        proxy_pass http://127.0.0.1:8069;
	}

    location /websocket {
        proxy_pass http://127.0.0.1:8069;
    }

    location ~* /web/static/ {
        proxy_cache_valid 200 90m;
        proxy_buffering on;
        expires 864000;
        proxy_pass http://127.0.0.1:8069;
    }
}


